# Marzban Environment Variables Template
# Copy to /opt/marzban/.env and fill in your values

UVICORN_HOST = "0.0.0.0"
UVICORN_PORT = 8000

# Telegram Bot (Admin)
TELEGRAM_API_TOKEN = "YOUR_BOT_TOKEN_HERE"
TELEGRAM_ADMIN_ID = YOUR_TELEGRAM_ID_HERE

# Database
SQLALCHEMY_DATABASE_URL = "sqlite:////var/lib/marzban/db.sqlite3"

# Xray
XRAY_JSON = "/var/lib/marzban/xray_config.json"

# Node SSL (for connecting edge nodes)
NODE_CLIENT_CERT_FILE = "/var/lib/marzban/certs/client.pem"
NODE_CLIENT_KEY_FILE = "/var/lib/marzban/certs/client.key"
